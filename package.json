{
  "name": "currency-hunter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "client",
    "server"
  ],
  "description": "Currency Hunter Assignment",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "main": "src/index.tsx",
  "dependencies": {
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "loader-utils": "3.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/react": "18.2.38",
    "@types/react-dom": "18.2.15",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "4.4.4"
  },
  "scripts": {
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "start": "HOST=0.0.0.0 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "dev:client": "yarn workspace client start",
    "dev:server": "yarn workspace server dev",
    "dev": "concurrently -k \"yarn dev:server\" \"yarn dev:client\""
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
