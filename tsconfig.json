{
    "include": ["./client/src/**/*"],
    "compilerOptions": {
      "strict": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "Node",
      "lib": ["DOM", "DOM.Iterable", "ES2020"],
      "jsx": "react-jsx",
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    }
  }
  