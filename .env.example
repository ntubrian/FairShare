# Client
REACT_APP_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
# Client
REACT_APP_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
# Optional local auth token to call protected GraphQL queries.
REACT_APP_GOOGLE_CLIENT_ID=
# Optional local dev bypass header when ALLOW_DEV_AUTH_BYPASS=true on server.
REACT_APP_DEV_USER_ID=
# Optional: allow service worker registration in development.
REACT_APP_ENABLE_SW=false

CLIENT_PORT=3000
# Server
PORT=4000
DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
GOOGLE_CLIENT_ID=<google-oauth-client-id>

# Local development only: allow `x-user-id` auth bypass in GraphQL requests.
ALLOW_DEV_AUTH_BYPASS=false

# Enable GraphQL web IDE redirect to Apollo Sandbox at /sandbox (and /playground alias).
# Default: true in development, false in production.
GRAPHQL_IDE_ENABLED=true

# Optional: force Apollo Sandbox endpoint when running behind tunnels/proxies.
# Example: https://your-app-4000.csb.app/graphql
GRAPHQL_PUBLIC_ENDPOINT=


# Server
